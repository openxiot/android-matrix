<?xml version="1.0" encoding="utf-8"?>
<!--
  Modbus 点表 / 服务 —— the largest module in the app. This is **English** (the
  default); Chinese is in values-zh/.

  Why the keys are prefixed per subject rather than per screen: almost all of this
  vocabulary lives in `ui/modbus/*Format.kt` (pure functions with no Context) and is
  consumed by screens both inside and outside `ui/modbus` — the failure-type
  dictionary is read by the two history screens, the alarm level/operator words by
  the alarm screen. The owning *file* is the stable thing here, not the reading screen,
  so the keys follow the file.

  Three groups are language-neutral and deliberately have **no** resource:
    - `coilStateLabel` (ON / OFF / -),
    - the frame field name `CRC16`,
    - the `-` stand-ins for "no value".
  They are protocol constants and dashes; translating them is not a thing that can
  happen, and a resource that is identical in both languages is noise.
-->
<resources>
    <!-- ===== 功能码 ===== -->
    <string name="modbus_fc_read_coils">Read coils</string>
    <string name="modbus_fc_read_discrete">Read discrete inputs</string>
