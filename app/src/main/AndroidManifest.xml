<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!--
      自更新：安装自己下载的 APK。这是**特殊权限**，不是运行时弹窗 —— 系统把它做成
      「安装未知应用」里的一个开关，应用只能把用户送到设置页自己开（见 ApkInstaller）。
      另注：这条权限是 Google Play 的政策限制项，只允许应用商店/文件管理器类应用用于
      自更新。当前走官网 sideload 分发，没问题；但将来若要上架 Play，必须改走 Play Core
      的 in-app update，不能带着这条权限提交。
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- 判断是否在计费网络上下 54MB。normal 权限，无弹窗 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".WeMatrixApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.WeMatrix">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.WeMatrix">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="openxiot"
                    android:host="oauth"
                    android:pathPrefix="/callback" />
            </intent-filter>
        </activity>

        <!--
          把下载好的安装包交给系统安装器。authority 用 ${applicationId} 占位符而不是写死
          "cc.openxiot.wematrix.fileprovider"：将来若加 applicationIdSuffix（比如 .debug），
          写死的那份会与调用点（ApkInstaller 用 packageName 拼）悄悄对不上，症状是安装时
          抛 IllegalArgumentException，而这里看起来毫无问题。
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".ui.scan.ScanQrActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.WeMatrix.Scan" />

        <activity
            android:name=".wxapi.WXEntryActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="wx1f1617264d7c7c34" />
            </intent-filter>
        </activity>
    </application>
</manifest>
